[?2004l# gitstat

Internal repository-analysis CLI used by the platform team.

## Commands

- `gitstat branches` — list the repo's branches
- `gitstat authors` — list distinct commit authors
- `gitstat activity` — commit activity by day

Run inside a git repository. Install for development with `pip install -e .`
and run the tests with `python -m pytest`.
[?2004h[01;32magent@b737b52e7104[00m:[01;34m/app[00m$ sed -n '1,200p' gitstat/utils.py
[?2004l"""Command helpers used across the analyzer.

The analyzer talks to git a lot. Most calls are small, but a couple of the
reports (author de-duplication, activity roll-ups) are easiest to express as a
shell pipeline, so the shared helper below takes a full command line.
"""

import subprocess


def run_cmd(cmd, cwd=None):
    """Run a git command line and return its stdout.

    Accepts a full command string so that reports using pipes (``sort``,
    ``uniq``) work the same way as the simple ones.
    """
    proc = subprocess.run(
        cmd,
        shell=True,
        cwd=cwd,
        capture_output=True,
        text=True,
    )
    return proc.stdout
